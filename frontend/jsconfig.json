{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"],
            "@components/*": ["src/components/*"],
            "@hooks/*": ["src/hooks/*"],
            "@services/*": ["src/services/*"],
            "@common/*": ["src/common/*"],
            "@utils/*": ["src/common/utils/*"]
        }
    },
    "exclude": ["node_modules", "dist"]
}
